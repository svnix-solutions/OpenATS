# ── Identity provider ────────────────────────────────────────────────────────
# Sign-in runs against an OIDC provider. The verified local setup is
# authorizer.dev — see docs-draft/IDENTITY_PROVIDERS.md.
NEXT_PUBLIC_AUTHORIZER_URL=http://localhost:8090
NEXT_PUBLIC_AUTHORIZER_CLIENT_ID=
# Server-side only. Grants full admin access to the provider's directory, so
# it must never be prefixed NEXT_PUBLIC_ — that would ship it to the browser.
AUTHORIZER_ADMIN_SECRET=

OPENATS_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=""

# Where this app is reachable, used to show the public careers-page URL.
NEXT_PUBLIC_APP_URL=

# Optional, and only for a public demo deployment. Set BOTH to show a
# credentials panel on the login page; leave either unset and nothing renders.
# Never set these on a real install — the values are shown to every visitor.
NEXT_PUBLIC_DEMO_USERNAME=
NEXT_PUBLIC_DEMO_PASSWORD=
