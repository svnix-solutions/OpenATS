NEXT_PUBLIC_ASGARDEO_BASE_URL=""
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=""
ASGARDEO_CLIENT_SECRET=""
NEXT_PUBLIC_ASGARDEO_SCOPES="openid profile email offline_access internal_user_mgt_create internal_user_mgt_delete internal_user_mgt_list internal_user_mgt_update internal_user_mgt_view internal_user_credential_mgt_create internal_user_credential_mgt_delete internal_user_credential_mgt_view internal_role_mgt_create internal_role_mgt_delete internal_role_mgt_groups_update internal_role_mgt_meta_create internal_role_mgt_meta_update internal_role_mgt_update internal_role_mgt_users_update internal_role_mgt_view"
ASGARDEO_SECRET=""
ASGARDEO_CLIENT_ID=""
NEXT_PUBLIC_ASGARDEO_SIGN_IN_URL=""

ASGARDEO_SUPER_ADMIN_ROLE_ID=""
ASGARDEO_HIRING_MANAGER_ROLE_ID=""
# Only needed on an install with client companies. setup-asgardeo.sh fills
# these in alongside the others.
ASGARDEO_CLIENT_ADMIN_ROLE_ID=
ASGARDEO_CLIENT_REVIEWER_ROLE_ID=
ASGARDEO_INTERVIEWER_ROLE_ID=""

OPENATS_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=""

# Optional. Only needed if the SCIM credentials differ from the sign-in ones —
# a separate Asgardeo application for user management. Falls back to
# ASGARDEO_CLIENT_ID, then NEXT_PUBLIC_ASGARDEO_CLIENT_ID.
ASGARDEO_SCIM_CLIENT_ID=
ASGARDEO_SCIM_CLIENT_SECRET=

# Optional. Server-side fallback for NEXT_PUBLIC_ASGARDEO_BASE_URL.
ASGARDEO_BASE_URL=

# Optional. Scopes requested for the SCIM management token. Defaults to the
# set user management needs; override only to narrow or extend it.
ASGARDEO_MANAGEMENT_SCOPES=

# Where this app is reachable, used to show the public careers-page URL.
NEXT_PUBLIC_APP_URL=
