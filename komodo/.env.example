# The variables the Komodo Stack supplies to komodo/compose.yaml.
#
# In Komodo these are set on the Stack itself (Config → Environment), not
# committed here. Komodo writes them to a file and passes it to
# `docker compose --env-file`, so anything marked secret stays out of the repo.
#
# This file exists to say what the stack needs, and is what you paste into that
# box before filling in the values.

# ── Database ────────────────────────────────────────────────────────────────
# The owner. Migrations run as this role; the application never does.
POSTGRES_USER=openats
POSTGRES_PASSWORD=
POSTGRES_DB=openats
# The least-privileged role the application connects as. Row-level security is
# the tenancy boundary and superusers and owners bypass it, so this being a
# separate role is not cosmetic — the server refuses to start otherwise.
APP_DATABASE_PASSWORD=

# ── Where this install is reachable ─────────────────────────────────────────
# Bare origins, no trailing /api: the frontend appends the path itself.
NEXT_PUBLIC_API_URL=https://api.ats.example.com
NEXT_PUBLIC_APP_URL=https://ats.example.com
# How this install is reached. compose.yaml publishes no ports; the overlay
# named in the Stack's `file_paths` decides.
#
# With compose.tunnel.yaml — the proxy is a container on its own network:
PROXY_NETWORK=cloudflared
#
# With compose.ports.yaml — the proxy runs on the host. Keep the loopback
# prefix; a bare port number binds 0.0.0.0 and stays reachable long after
# whatever was in front of it has moved.
# BACKEND_PORT=127.0.0.1:8080
# FRONTEND_PORT=127.0.0.1:3000
# AUTHORIZER_PORT=127.0.0.1:8090

# How many proxies sit in front of the API. 0 is right only when browsers reach
# it directly. Set it to 1 behind a single tunnel or reverse proxy: Express
# otherwise reads the client address off the socket, every request looks like
# it came from the proxy, and the IP-keyed limiters on /public/* and
# /files/logos become one bucket shared by the whole internet.
#
# A count, never `true`: a client writes X-Forwarded-For itself, so trusting
# the whole chain lets anyone claim a new address per request.
TRUST_PROXY=0

# ── Identity ────────────────────────────────────────────────────────────────
# The stack runs its own authorizer.dev instance. Point a DNS name at
# AUTHORIZER_PORT and put it here — it is the address browsers use and the
# `iss` claim on every token, and the provider refuses to start without it.
NEXT_PUBLIC_AUTHORIZER_URL=https://auth.example.com

# Any UUID; it identifies this deployment's own client.
NEXT_PUBLIC_AUTHORIZER_CLIENT_ID=
# Secrets. `openssl rand -hex 24` will do for each.
AUTHORIZER_CLIENT_SECRET=
AUTHORIZER_ENCRYPTION_KEY=
# Full access to the user directory — never prefix this one NEXT_PUBLIC_,
# which would ship it to every browser.
AUTHORIZER_ADMIN_SECRET=

# The role a self-registered account lands on. Signup cannot be disabled —
# OpenATS creates users through the same mutation and turning it off refuses
# both — so this is what stands between a stranger and your data. Leave it at
# the least privilege and raise people in Settings → User Management.
AUTHORIZER_DEFAULT_ROLES=interviewer

# Set to false only if the provider is served over plain http, which no
# deployment reachable from a browser should be.
AUTHORIZER_COOKIE_SECURE=true
AUTHORIZER_COOKIE_SAME_SITE=lax

# Only if you are using an identity provider you already run instead of the
# one in this stack. Otherwise leave both unset: the backend fetches keys from
# the authorizer container directly and trusts the issuer above.
# OIDC_JWKS_URL=
# OIDC_ISSUER=

# ── Secrets ─────────────────────────────────────────────────────────────────
# base64 of 32 random bytes: `make encryption-key`
ENCRYPTION_KEY=

# ── Mail ────────────────────────────────────────────────────────────────────
# An address on a domain verified in Resend. The sandbox sender
# onboarding@resend.dev delivers only to the Resend account owner and drops
# everything else silently; the server warns at startup if it sees it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: send over SMTP instead of Resend. Leave SMTP_HOST empty to use
# Resend. Both paths format mail identically — only the transport differs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# ── Object storage (CVs, logos) ─────────────────────────────────────────────
# Any S3-compatible bucket; docs-draft/STORAGE.md covers B2, MinIO and Spaces.
# Keep it PRIVATE.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Only away from R2, which ignores the region and signs as us-east-1. B2 and
# MinIO check it against the endpoint and fail the signature if it disagrees.
R2_REGION=

# Where a browser fetches stored files, which is NOT the endpoint above. Point
# it at the frontend's own /api/files — the same host as FRONTEND_URL — and the
# bucket needs no public access: reads are authorized there and answered with a
# short-lived signed URL. Pointing it straight at the bucket's CDN host means
# every CV in it is readable by anyone who has ever seen the URL.
R2_PUBLIC_URL=https://openats.example.com/api/files

# ── CV analysis ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Error tracking is off without it, which is what a staging box usually wants.
SENTRY_DSN=
LOG_LEVEL=info
