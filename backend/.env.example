# The application connects as a least-privileged role. Row-level security is
# bypassed by superusers and by table owners, so connecting as either one
# would silently ignore every policy.
DATABASE_URL=postgresql://openats_app:openats_app@localhost:5432/openats

# Migrations need the owner. Only drizzle-kit reads this.
MIGRATION_DATABASE_URL=postgresql://openats:openats@localhost:5432/openats
# ── Object storage (CVs and logos) ───────────────────────────────────────────
# Any S3-compatible store. R2, Backblaze B2, MinIO and S3 itself are all just
# these values; see docs-draft/STORAGE.md for what each provider calls them.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The base a browser fetches stored files from, which is not the endpoint the
# API writes to. Point it at the app's own /api/files and the bucket can stay
# private: reads are authorized there and answered with a short-lived signed
# URL. A bucket that is world-readable can go straight at the CDN host instead,
# but then every CV in it is readable by anyone who has ever seen its URL.
R2_PUBLIC_URL=http://localhost:3000/api/files
# The region in the signature. R2 and Backblaze B2 both ignore it entirely, so
# leave it blank for either. AWS S3 checks it, and MinIO checks when one is
# configured — set it to match the endpoint there.
R2_REGION=
# ── Outgoing mail ────────────────────────────────────────────────────────────
# Set SMTP_HOST to send over SMTP instead of Resend. `docker compose up -d
# mailpit` runs a catcher that accepts anything on 1025 and shows it at
# http://localhost:8025 — so offer, rejection and interview emails can be read
# rather than sent for real, or assumed fine because nothing errored.
SMTP_HOST=
SMTP_PORT=1025
# Both only matter when SMTP_HOST points at something other than the catcher.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

OIDC_JWKS_URL=
OIDC_ISSUER=

GEMINI_API_KEY=
PORT=8080

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Set to "true" only if the service account has Domain-Wide Delegation -
# otherwise attendee invites fail and events list attendees in the description.
GOOGLE_CALENDAR_ALLOW_ATTENDEES=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

ENCRYPTION_KEY=
# Proxies in front of the API. 0 when browsers reach it directly; 1 behind a
# tunnel or reverse proxy, or the IP-keyed limiters all share one bucket.
TRUST_PROXY=0
# Where providers reach this API from outside — not FRONTEND_URL, which is a
# different hostname behind a proxy. Shown to operators as the webhook URL to
# paste into Meta's configuration screen; unset, the screen says it cannot show
# one rather than guessing.
PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# Optional. Requests per user per 15 minutes on the authenticated API.
# Defaults are 1000 for general routes and 60 for uploads.
RATE_LIMIT_API=1000
RATE_LIMIT_EXPENSIVE=60

# Optional. winston level: error | warn | info | debug. Defaults to info.
# Logs are JSON on one line per event when NODE_ENV=production, readable otherwise.
LOG_LEVEL=

# Error tracking. Leave blank to turn it off — which is what development, CI
# and the test suite want; nothing is sent and no client is started.
# Never commit a real DSN: this file is checked in.
SENTRY_DSN=
# Ties an error to the commit that shipped it. Set this in the deploy.
SENTRY_RELEASE=
# Performance tracing, off by default. 0.1 samples one request in ten.
SENTRY_TRACES_SAMPLE_RATE=

# Only read by the seed script, and only when more than one organization
# exists — it refuses to guess which one to seed.
SEED_ORGANIZATION_ID=
