DATABASE_URL=postgresql://openats_app:openats_app@localhost:5433/openats_test
MIGRATION_DATABASE_URL=postgresql://openats:openats@localhost:5433/openats_test
REDIS_URL=redis://localhost:6379

OIDC_JWKS_URL=http://localhost/jwks
OIDC_ISSUER=http://localhost
# Empty on purpose, and not merely absent. mail.service calls dotenv.config()
# itself, so a developer with SMTP_HOST set in backend/.env — which is exactly
# what `docker compose up -d mailpit` asks for — otherwise sends the suite down
# the SMTP path, and the tests that assert what Resend was handed all fail.
# Tests must not depend on whose machine they run on.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

RESEND_API_KEY=re_test_000000000000000000000000
GEMINI_API_KEY=test-gemini-key

# Dummy AES-256 key: integration tests exercise the OAuth state signing.
# Not a secret — a fixed all-sevens buffer, like every other value here.
ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
